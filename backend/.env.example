# Loaded as Java properties when starting from the backend directory.
# Use unquoted values. Set DB_PASSWORD to your local database role's password.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freshmart_pos
DB_USERNAME=freshmart
DB_PASSWORD=

# Base64-encoded random key (at least 32 bytes). See docs/authentication.md.
JWT_SECRET=
JWT_TTL=PT1H
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
# Local HTTP only; set true with HTTPS outside development.
AUTH_COOKIE_SECURE=false
DEV_USERS_ENABLED=true
# Development defaults; used only when the matching account does not exist.
DEV_ADMIN_PASSWORD=Admin@FreshMart123
DEV_CASHIER_PASSWORD=Cashier@FreshMart123

# Checkout percentage, applied after the fixed amount discount (0–100, up to 2 decimals).
CHECKOUT_TAX_RATE=0
