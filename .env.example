# Docker Compose only. Keep backend/.env and frontend/.env for native development.
COMPOSE_PROJECT_NAME=freshmart
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
FRONTEND_ORIGINS=http://localhost:3000
DB_NAME=freshmart_pos
DB_USERNAME=freshmart
# Required: unique random password and base64 JWT key (at least 32 random bytes).
DB_PASSWORD=
JWT_SECRET=
JWT_TTL=PT1H
# Local HTTP only. Set true and use HTTPS when exposing the app publicly.
AUTH_COOKIE_SECURE=false
# Enable only to create missing initial accounts; disable after first startup.
BOOTSTRAP_USERS_ENABLED=true
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CASHIER_PASSWORD=
CHECKOUT_TAX_RATE=0
STORE_TIME_ZONE=Asia/Colombo
STORE_NAME=FreshMart
