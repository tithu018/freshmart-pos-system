# Copy to state.backend.hcl (ignored) and replace these non-secret placeholders.
# The private bucket must already exist. Choose a separate state key per environment.
bucket       = "replace-with-existing-private-state-bucket"
key          = "freshmart/dev/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true
# For a customer-managed encryption key, set its existing ARN (not a secret).
# kms_key_id = "arn:aws:kms:ap-south-1:123456789012:key/REPLACE_WITH_EXISTING_KEY_ID"
