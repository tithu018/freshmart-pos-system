# Local environment files
.env
.env.*
!.env.example

# Frontend dependencies and builds
node_modules/
dist/
.vite/

# Backend builds
target/

# Local logs and editor files
*.log
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Terraform working data, plans and private configuration
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.tfvars
*.tfvars.json
*.backend.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Keep provider locks and safe *.example files in version control.

# Kubernetes local credentials and test state (never commit generated Secrets)
devops/kubernetes/.local/
devops/kubernetes/*secret*.local.*

# Helm local overrides, rendered output and private test artifacts
devops/helm/.local/
devops/helm/values-*.local.yaml
devops/helm/*.tgz
